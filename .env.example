# API Backend URL
VITE_API_URL=http://localhost:3000

# Opcional: tema padrão (light ou dark). Se vazio, segue sistema do browser.
# VITE_DEFAULT_THEME=light

# Cloudflare Turnstile (Anti-robô)
# Em produção, crie um site em: https://dash.cloudflare.com/?to=/:account/turnstile
# Obtenha a Site Key pública e insira abaixo.
# Se deixado em branco em DEV, a verificação humana será ignorada (modo dev-bypass).
# Chave de teste oficial Cloudflare (sempre passa): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=